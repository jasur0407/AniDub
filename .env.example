# Server port
PORT=3000

# First admin account (used only when the database has no admins yet).
# If ADMIN_PASSWORD is empty, a random password is generated and printed once in the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Max video upload size in megabytes
MAX_VIDEO_MB=4096

# Set to true when the site is served over HTTPS (makes the login cookie Secure)
COOKIE_SECURE=false

# Set to true when running behind a reverse proxy (nginx, Render, Railway, ...)
TRUST_PROXY=false
