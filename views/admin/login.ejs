<%- include('../partials/head') %>
<main class="login-page">
  <form class="login-card" method="post" action="/admin/login">
    <a href="/" class="logo">
      <%- include('../partials/brand', { size: 46 }) %>
    </a>
    <h1>Admin panelga kirish</h1>
    <p class="muted">Anime va qismlarni boshqarish uchun tizimga kiring.</p>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <input type="hidden" name="next" value="<%= next %>">
    <label class="field">
      <span>Login</span>
      <input type="text" name="username" value="<%= username %>" autocomplete="username" required autofocus>
    </label>
    <label class="field">
      <span>Parol</span>
      <input type="password" name="password" autocomplete="current-password" required>
    </label>
    <button class="btn btn-primary btn-block btn-lg" type="submit">Kirish</button>
    <a class="muted back-link" href="/">← Saytga qaytish</a>
  </form>
</main>
</body>
</html>
