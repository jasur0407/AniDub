{
  "name": "uzanidub",
  "version": "1.0.0",
  "private": true,
  "description": "UzAniDub — animelarni oʻzbek tilida tomosha qilish uchun sayt",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server.js",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed.js"
  },
  "dependencies": {
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.4.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
